{
  "id": 3,
  "name": "The Studio",
  "background": {
    "type": "segmented",
    "dir": "assets/backgrounds/level_3_segments",
    "metadata": "assets/backgrounds/level_3_segments/metadata.json"
  },
  "world": { "top": 448, "bottom": 690 },
  "perspectiveVariance": 0.6,
  "spawn": { "x": 240, "y": 550 },
  "audio": {
    "music": "crisisMusic",
    "musicVolume": 0.5
  },
  "enemies": {
    "spawnRate": 1200,
    "max": 6,
    "types": ["scumbag_rapper", "scumbag_manager"],
    "multipliers": { "health": 1.0, "damage": 1.0 }
  },
  "extras": [],
  "events": [
    {
      "id": "level_3_intro",
      "trigger": { "type": "position", "value": 100, "tolerance": 60, "once": true },
      "actions": [
        { "type": "pause", "targets": ["player", "enemies"] },
        { "type": "wait", "duration": 1200 },
        { "type": "dialogue", "dialogue": { "speaker": "Tireek", "text": "We're in. Whole place smells like stale smoke and bad deals." } },
        { "type": "dialogue", "dialogue": { "speaker": "Tryston", "text": "Then the drive is down that hall. Keep moving." } },
        { "type": "resume", "targets": ["player", "enemies"] }
      ]
    },
    {
      "id": "level_3_negatives_reveal",
      "trigger": { "type": "position", "value": 3450, "tolerance": 50, "once": true },
      "actions": [
        { "type": "pause", "targets": ["player", "enemies"] },
        { "type": "stopEnemySpawning", "clearEnemies": true },
        { "type": "spawnEnemy", "enemyType": "negative_tireek", "position": { "x": 3720, "y": 452 }, "id": "enemy_neg_tireek_cameo", "flipX": true, "protectionLevel": "invulnerable" },
        { "type": "spawnEnemy", "enemyType": "negative_tryston", "position": { "x": 3880, "y": 480 }, "id": "enemy_neg_tryston_cameo", "flipX": true, "protectionLevel": "invulnerable" },
        { "type": "dialogue", "dialogue": { "speaker": "Tireek", "text": "Whoa! That's... that's a negative version of us!" } },
        { "type": "dialogue", "dialogue": { "speaker": "Tryston", "text": "Yeah... this can't be good." } },
        { "type": "dialogue", "dialogue": { "speaker": "Negative Tireek", "text": "Surprised? The label built us to look just like you." } },
        { "type": "dialogue", "dialogue": { "speaker": "Negative Tryston", "text": "We took your album so you'd have no leverage left." } },
        { "type": "dialogue", "dialogue": { "speaker": "Negative Tireek", "text": "No album means no choice. You'll sign whatever 360 deal they put in front of you." } },
        { "type": "dialogue", "dialogue": { "speaker": "Negative Tryston", "text": "Meet us out back if you want it. Get through the label's people first." } },
        { "type": "flip", "target": "enemy_neg_tireek_cameo", "flipX": false },
        { "type": "flip", "target": "enemy_neg_tryston_cameo", "flipX": false },
        { "type": "move", "target": "enemy_neg_tireek_cameo", "to": { "x": "+=700", "y": 452 }, "duration": 1000, "ease": "Power2", "destroyOnComplete": true },
        { "type": "move", "target": "enemy_neg_tryston_cameo", "to": { "x": "+=700", "y": 480 }, "duration": 1000, "ease": "Power2", "destroyOnComplete": true },
        { "type": "waitForEnemyDestroy", "target": "enemy_neg_tireek_cameo" },
        { "type": "dialogue", "dialogue": { "speaker": "Narrator", "text": "The label's own execs flood in to cover their escape, 360 contracts already in hand." } },
        { "type": "dialogue", "dialogue": { "speaker": "Exec", "text": "Sign here, and all of this goes away." } },
        { "type": "playMusic", "musicKey": "riverMusic" },
        { "type": "startEnemySpawning", "config": { "maxEnemies": 6, "spawnInterval": 1100, "allowedEnemyTypes": ["exec"] } },
        { "type": "resume", "targets": ["player", "enemies"] }
      ]
    },
    {
      "id": "level_3_exit_to_alley",
      "trigger": { "type": "position", "value": 6700, "tolerance": 50, "once": true },
      "actions": [
        { "type": "pause", "targets": ["player", "enemies"] },
        { "type": "camera", "stopFollow": true },
        { "type": "stopEnemySpawning", "clearEnemies": true },
        { "type": "dialogue", "dialogue": { "speaker": "Tryston", "text": "Back door's open. They went out into the alley." } },
        { "type": "dialogue", "dialogue": { "speaker": "Tireek", "text": "Good. No more running." } },
        { "type": "fade", "direction": "out", "duration": 1000, "color": { "r": 0, "g": 0, "b": 0 } },
        { "type": "loadLevel", "levelId": 4 }
      ]
    }
  ],
  "assets": {
    "images": []
  }
}
