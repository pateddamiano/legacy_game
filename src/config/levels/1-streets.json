{
  "id": 1,
  "name": "The Streets",
  "background": {
    "type": "segmented",
    "dir": "assets/backgrounds/level_1_segments",
    "metadata": "assets/backgrounds/level_1_segments/metadata.json"
  },
  "world": { "top": 410, "bottom": 650 },
  "spawn": { "x": 185, "y": 512 },
  "parallaxTexture": "parallax_background",
  "audio": { "music": "fadeMusic", "ambiance": "streetAmbiance", "ambianceVolume": 0.15 },
  "enemies": {
    "spawnRate": 1300,
    "musicVolume": 0.5,
    "max": 5,
    "types": ["green_thug", "black_thug"],
    "multipliers": { "health": 1.0, "damage": 1.0 }
  },
  "extras": [
    { "name": "rozotadi" }
  ],
  "events": [
    {
      "id": "level_1_intro",
      "trigger": { "type": "position", "value": 185, "tolerance": 40, "once": true },
      "actions": [
        { "type": "pause", "targets": ["player", "enemies"] },
        { "type": "camera", "stopFollow": true },
        { "type": "spawnExtra", "name": "rozotadi", "position": { "x": 542, "y": 513 }, "id": "extra_rozotadi", "matchPlayer": true, "multiplier": 1.0 },
        { "type": "flip", "target": "extra_rozotadi", "flipX": true },
        { "type": "dialogue", "dialogue": { "speaker": "Rozotadi", "text": "Yo! I saw the guy that had your album run towards the subway.. ", "dimBackground": false } },
        { "type": "dialogue", "dialogue": { "speaker": "Rozotadi", "text": "I'm pretty sure it was *The Critic*...", "dimBackground": false } },
        { "type": "dialogue", "dialogue": { "speaker": "Rozotadi", "text": "Go get that drive back!", "dimBackground": false } },
        { "type": "destroyExtra", "target": "extra_rozotadi" },
        { "type": "camera", "follow": "player" },
        { "type": "resume", "targets": ["player", "enemies"] },
        { "type": "triggerEvent", "eventId": "level_1_tutorial" }
      ]
    },
    {
      "id": "level_1_tutorial",
      "actions": [
        { "type": "tutorialStart", "text": "Heads up!" },
        { "type": "showEmote", "target": "player", "text": "!", "duration": 2600 },
        { "type": "tutorialSpawn", "enemies": [
          { "type": "green_thug", "id": "tut_1", "x": 860, "y": 480 },
          { "type": "black_thug", "id": "tut_2", "x": 1010, "y": 600 }
        ] },
        { "type": "tutorialStep", "step": "move",
          "touchText": "Drag the stick to move around.",
          "keyText": "Use the ARROW KEYS to move around." },
        { "type": "tutorialStep", "step": "jump",
          "touchText": "Tap this button to jump.",
          "keyText": "Press SPACE to jump." },
        { "type": "tutorialStep", "step": "throw",
          "touchText": "Line up with an enemy and tap this button to throw a record.",
          "keyText": "Line up with an enemy and press Q to throw a record.",
          "rechargeText": "Hit! Records recharge after every throw - you can throw again once it's full.",
          "retryTouchText": "Missed! Move up or down to line up with an enemy, then throw again.",
          "retryKeyText": "Missed! Move up or down to line up with an enemy, then press Q again.",
          "successText": "Direct hit!" },
        { "type": "tutorialStep", "step": "punch",
          "touchText": "Walk up to an enemy and tap this button to punch.",
          "keyText": "Walk up to an enemy and press X to punch." },
        { "type": "tutorialSpawn", "enemies": [
          { "type": "green_thug", "id": "tut_3", "nearPlayer": -190 },
          { "type": "black_thug", "id": "tut_4", "nearPlayer": 190 }
        ] },
        { "type": "tutorialStep", "step": "switch",
          "touchText": "Tap this button to switch between Tireek and Tryston. The wind from the switch pushes enemies away!",
          "keyText": "Press C to switch between Tireek and Tryston. The wind from the switch pushes enemies away!",
          "successText": "Blown away!", "waitForTap": true },
        { "type": "tutorialStep", "step": "info",
          "touchText": "Whoever you're NOT playing as recharges their health. Switch out a hurt fighter to let them heal!",
          "keyText": "Whoever you're NOT playing as recharges their health. Switch out a hurt fighter to let them heal!" },
        { "type": "tutorialEnd", "text": "You're ready. Go find the album!" }
      ]
    },
    {
      "id": "level_1_end",
      "trigger": { "type": "position", "value": 8081, "tolerance": 50, "once": true },
      "actions": [
        { "type": "pause", "targets": ["player", "enemies"] },
        { "type": "camera", "stopFollow": true },
        { "type": "stopEnemySpawning", "clearEnemies": false },
        { "type": "clearEnemiesOffscreen", "xThreshold": 8600, "direction": "right", "excludeIds": ["enemy_critic"] },
        { "type": "spawnEnemy", "enemyType": "critic", "position": { "x": 8655, "y": 518 }, "id": "enemy_critic", "flipX": true, "protectionLevel": "invulnerable" },
        { "type": "showEmote", "target": "player", "text": "!", "duration": 2600 },
        { "type": "wait", "duration": 400 },
        { "type": "camera", "pan": { "x": 7845 }, "duration": 2000, "ease": "Power2" },
        { "type": "camera", "setBounds": { "x": 7845, "y": 0, "width": 2400, "height": 720 } },
        { "type": "wait", "duration": 500 },
        { "type": "clearEnemiesOffscreen", "xThreshold": 8600, "direction": "right", "excludeIds": ["enemy_critic"] },
        { "type": "dialogue", "dialogue": { "speaker": "Critic", "text": "You'll never get this album back..." } },
        { "type": "dialogue", "dialogue": { "speaker": "Critic", "text": "...and you'll never make it in this city!" } },
        { "type": "wait", "duration": 500 },
        { "type": "flip", "target": "enemy_critic", "flipX": false },
        { "type": "move", "target": "enemy_critic", "to": { "x": 8711, "y": 410 }, "duration": 1500, "ease": "Power2", "destroyOnComplete": true },
        { "type": "waitForEnemyDestroy", "target": "enemy_critic" },
        { "type": "dialogue", "dialogue": { "speaker": "Narrator", "text": "Survive the fight to go after The Critic!" } },
        { "type": "wait", "duration": 500 },
        { "type": "clearAllEnemies", "excludeIds": [] },
        { "type": "resume", "targets": ["player", "enemies"] },
        { "type": "camera", "stopFollow": true },
        { "type": "setPlayerBounds", "bounds": { "minX": 7850, "maxX": 9040, "minY": 410, "maxY": 650 } },
        { "type": "startEnemySpawning", "config": { "maxEnemies": 7, "spawnInterval": 600 } },
        { "type": "wait", "duration": 12000 },
        { "type": "stopEnemySpawning", "clearEnemies": false },
        { "type": "waitForEnemiesCleared" },
        { "type": "pause", "targets": ["player", "enemies"] },
        { "type": "dialogue", "dialogue": { "speaker": "Narrator", "text": "Enter the subway to chase The Critic!" } },
        { "type": "resume", "targets": ["player", "enemies"] },
        { "type": "waitForZone", "zone": { "x1": 8550, "x2": 8753, "y1": 380, "y2": 440 } },
        { "type": "fade", "direction": "out", "duration": 1000, "color": { "r": 0, "g": 0, "b": 0 } },
        { "type": "loadLevel", "levelId": 2 }
      ]
    }
  ],
  "assets": { "images": [] }
}


